{
  "$schema": "https://opencode.ai/config.json",

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "permission": {
    "skill": {
      "*": "deny",
      "senior-frontend": "allow"
    }
  },

  "mcp": {
    "better-icons": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "better-icons"
      ],
      "enabled": false
    },

    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },

    "iconserve": {
      "enabled": false
    }
  }
}