{
  "$schema": "https://opencode.ai/config.json",

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "permission": {
    "skill": {
      "*": "deny",
      "superdesign": "allow"
    }
  },

  "agent": {
    "designer": {
      "description": "Designs and improves frontend UI using the SuperDesign skill and the project's existing design system.",
      "mode": "subagent",
      "permission": {
        "skill": {
          "superdesign": "allow"
        },
        "edit": "deny"
      }
    }
  },

  "mcp": {
    "better-icons": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "better-icons"
      ],
      "enabled": false
    },

    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },

    "iconserve": {
      "enabled": false
    },

    "graphiti": {
      "type": "remote",
      "url": "http://localhost:8000/mcp/",
      "enabled": true
    },

    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": false
    },

    "marm-memory": {
      "type": "local",
      "command": [
        "marm-mcp-stdio"
      ],
      "enabled": true
    }
  }
}

//marm-mcp-stdio do not remove this comment as it's useful